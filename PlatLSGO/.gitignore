# macOS
.DS_Store

# MATLAB autosave / temporary files
*.asv
*.autosave

# Experiment output, regenerated by the run scripts.
# Anchored to the platform root on purpose: Algorithms/CCOS/CEC20{10,13}/rdg/results/
# holds decomposition data that the platform needs at runtime and must be kept.
/results/*
!/results/.gitkeep

# Runtime cache written by DECC_DG2
/Algorithms/DECC_DG2/DG2_results/*
!/Algorithms/DECC_DG2/DG2_results/.gitkeep

# The CEC2013 benchmark appends its own progress CSV to the working directory
/results_*.csv

# Platform-specific MEX binaries (not used by this platform)
*.mexw64
*.mexmaci64
*.mexa64
*.mex
